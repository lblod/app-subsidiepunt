PREFIX m8g: <http://data.europa.eu/m8g/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Pride evenementen
# Update title & preflabel (ignore oldLink)
DELETE {
  GRAPH ?g {
    <http://data.lblod.info/id/subsidy-measure-offers/a03196fb-5ec6-48ab-812d-bbd8daf219d1> dct:title ?oldTitle ;
                                                                                           skos:prefLabel ?oldPrefLabel .
  }
}
INSERT {
  GRAPH ?g {
    <http://data.lblod.info/id/subsidy-measure-offers/a03196fb-5ec6-48ab-812d-bbd8daf219d1> dct:title "Pride-evenementen" ;
                                                                                           skos:prefLabel "Pride-evenementen" .  }
}
WHERE {
  GRAPH ?g {
    OPTIONAL { <http://data.lblod.info/id/subsidy-measure-offers/a03196fb-5ec6-48ab-812d-bbd8daf219d1> dct:title ?oldTitle . }
    OPTIONAL { <http://data.lblod.info/id/subsidy-measure-offers/a03196fb-5ec6-48ab-812d-bbd8daf219d1> skos:prefLabel ?oldPrefLabel . }
  }
}
