PREFIX cpsv: <http://purl.org/vocab/cpsv#>
PREFIX common: <http://www.w3.org/2007/uwa/context/common.owl#>
PREFIX transactie: <http://data.vlaanderen.be/ns/transactie#>
PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dct: <http://purl.org/dc/terms/>

# Deploy on 1 December 2026, not before.
# This sets opvolgmenent 2027 as active step for LEKP 1.0
DELETE {
  GRAPH ?g {
    ?consumption common:active ?oldStep ;
      adms:status ?oldStatus .
  }
}
INSERT {
  GRAPH ?g {
    ?consumption common:active <http://lblod.data.info/id/subsidie-application-flow-steps/2cbd5674-5d75-4341-9c8f-f1c3ba67bfa0> ;
      adms:status <http://lblod.data.gift/concepts/c849ca98-455d-4f31-9e95-a3d9d06e4497> .
  }
}
WHERE {
  GRAPH ?g {
    ?consumption transactie:isInstantieVan <http://lblod.data.info/id/subsidy-measure-offers/64d40351-8128-464f-990f-41066154583e> ;
      cpsv:follows <http://lblod.data.info/id/subsidie-application-flows/83353c51-0d65-44bb-b3a7-6b8701b395c9> ;
      dct:source ?proposalForm .
    ?proposalForm dct:isPartOf <http://lblod.data.info/id/subsidie-application-flow-steps/c50d7726-4880-43e2-b098-c356722a3096> ; # Indienen voorstel
      adms:status <http://lblod.data.gift/concepts/9bd8d86d-bb10-4456-a84e-91e9507c374c> .
    OPTIONAL { ?consumption common:active ?oldStep . }
    OPTIONAL { ?consumption adms:status ?oldStatus . }
  }
  FILTER(REGEX(STR(?g), "^http://mu.semte.ch/graphs/organizations/.+/SubsidiepuntGebruiker$"))
}
