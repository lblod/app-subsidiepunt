PREFIX adms: <http://www.w3.org/ns/adms#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX subsidie: <http://data.vlaanderen.be/ns/subsidie#>
PREFIX lblodSubsidie: <http://lblod.data.gift/vocabularies/subsidie/>

# e-inclusie: consumptions whose last step (verantwoording) was successfully submitted
# should have VERSTUURD (done) status instead of ACTIVE

DELETE {
  GRAPH ?g {
    ?consumption adms:status <http://lblod.data.gift/concepts/c849ca98-455d-4f31-9e95-a3d9d06e4497> . # ACTIVE
  }
}
INSERT {
  GRAPH ?g {
    ?consumption adms:status <http://lblod.data.gift/concepts/2ea29fbf-6d46-4f08-9343-879282a9f484> . # VERSTUURD / SENT
  }
}
WHERE {
  GRAPH ?g {
    ?consumption a subsidie:SubsidiemaatregelConsumptie ;
                 adms:status <http://lblod.data.gift/concepts/c849ca98-455d-4f31-9e95-a3d9d06e4497> ; # ACTIVE
                 dct:source ?form .
    ?form a lblodSubsidie:ApplicationForm ;
          dct:isPartOf <http://lblod.data.info/id/subsidie-application-flow-steps/958f92d1-988b-4bcd-8eff-9abe99756582> ; # e-inclusie verantwoording step
          adms:status <http://lblod.data.gift/concepts/2ea29fbf-6d46-4f08-9343-879282a9f484> ; # SENT
          dct:dateSubmitted ?date .
  }
  FILTER(STRSTARTS(STR(?g), "http://mu.semte.ch/graphs/organizations/") &&
         STRENDS(STR(?g), "/SubsidiepuntGebruiker"))
}
