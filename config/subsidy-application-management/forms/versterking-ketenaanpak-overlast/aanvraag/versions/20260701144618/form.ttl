@prefix : <#>.
@prefix form: <http://lblod.data.gift/vocabularies/forms/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix displayTypes: <http://lblod.data.gift/display-types/>.
@prefix emb: <http://ember-submission-form-fields/>.
@prefix lblodSubsidie: <http://lblod.data.gift/vocabularies/subsidie/>.
@prefix ext: <http://mu.semte.ch/vocabularies/ext/>.
@prefix custom: <http://mu.semte.ch/vocabularies/custom/>.
@prefix schema: <http://schema.org/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.

ext:contactPersonSection
    a form:Section;
    sh:name "Contactgegevens contactpersoon";
    sh:order 1 .

ext:politicalResponsibleSection
    a form:Section;
    sh:name "Politiek verantwoordelijke bij de gemeente/stad";
    sh:order 2 .

ext:questionsSection
    a form:Section;
    sh:name "Voor vragen kan je terecht op het adres: LokaleVeiligheid@vlaanderen.be";
    sh:order 3 .

ext:hiddenQuestionsField
    a form:Field;
    form:partOf ext:questionsSection;
    sh:name "Section Hidden Field".

ext:projectContentSection
    a form:Section;
    sh:name "Projectinhoud";
    sh:order 4 .

ext:financingSection
    a form:Section;
    form:help """
        Afhankelijk van het type indiening geldt een verschillend subsidiebedrag: voor
        een projectvoorstel waarbij lokale besturen samenwerken bedraagt dit minimaal
        <strong>110.000 euro</strong> tot maximaal <strong>120.000 euro</strong>, voor
        projectvoorstellen van afzonderlijke lokale besturen <strong>80.000 euro</strong>.
        De subsidie heeft betrekking op personeels- en werkingsmiddelen. Binnen elk
        projectvoorstel voorziet men een cofinanciering van min. <strong>20 procent</strong>
        ten aanzien van de ontvangen subsidie.
        <br>    
        <br>

        <strong>Duid hieronder het bedrag van de subsidie en geef aan waaraan de middelen
        zullen besteed worden.</strong>

        Geef aan via welke loka(a)l(e) bestu(u)r(en) en/of andere partners de subsidie zal
        worden ingezet. Deze informatie
        zal worden gebruikt bij de opmaak van een eventueel subsidiebesluit.
    """;
    sh:name "Financiering";
    sh:order 5 .

ext:cofinancieringSection
    a form:Section;
    form:help "Geef in onderstaande tabel het aandeel van elke partner in de cofinanciering aan.";
    sh:name "Cofinanciering";
    sh:order 6 .

ext:sustainabilitySection
    a form:Section;
    sh:name "Verduurzaming";
    sh:order 7 .

ext:attachmentSection
    a form:Section;
    form:help """
        Voeg, voor het trekkend lokale bestuur, het besluit van het college van burgemeester
        en schepenen toe. Aan consortia, bestaande uit een samenwerking tussen een lokaal
        bestuur met andere lokale besturen en/of andere organisaties, vragen we om per
        partner (lokaal bestuur, andere organisatie) een intentieverklaring toe te voegen.
        Zie sjabloon op
        <a href="https://www.vlaanderen.be/lokaal-bestuur/subsidieoproep-versterking-ketenaanpak-overlast"
            target="_blank">www.vlaanderen.be/lokaal-bestuur/subsidieoproep-versterking-ketenaanpak-overlast</a>.
    """;
    sh:name "Bijlagen";
    sh:order 8 .

ext:contactPersonFirstName
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:contactPersonSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( schema:contactPoint foaf:firstName );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Voornaam";
    sh:order 1;
    sh:path ( schema:contactPoint foaf:firstName ) .

ext:contactPersonFamilyName
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:contactPersonSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( schema:contactPoint foaf:familyName );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Familienaam";
    sh:order 2;
    sh:path ( schema:contactPoint foaf:familyName ) .

ext:contactPersonJobTitle
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:contactPersonSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( schema:contactPoint schema:jobTitle );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Functie";
    sh:order 3;
    sh:path ( schema:contactPoint schema:jobTitle ) .

ext:contactPersonTelephone
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:contactPersonSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( schema:contactPoint schema:telephone );
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:ValidPhoneNumber;
        form:defaultCountry "BE";
        form:grouping form:MatchEvery;
        sh:path ( schema:contactPoint schema:telephone );
        sh:resultMessage "Geef een geldig telefoonnummer in."
    ];
    sh:name "Telefoon";
    sh:order 4;
    sh:path ( schema:contactPoint schema:telephone ) .

ext:contactPersonEmail
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:contactPersonSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( schema:contactPoint schema:email );
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:ValidEmail;
        form:grouping form:MatchEvery;
        sh:path ( schema:contactPoint schema:email );
        sh:resultMessage "Geef een geldig e-mailadres op."
    ];
    sh:name "E-mail";
    sh:order 5;
    sh:path ( schema:contactPoint schema:email ) .

ext:politicalResponsibleFirstName
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:politicalResponsibleSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( ext:politicalResponsibleContactPoint foaf:firstName );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Voornaam";
    sh:order 1;
    sh:path ( ext:politicalResponsibleContactPoint foaf:firstName ) .

ext:politicalResponsibleFamilyName
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:politicalResponsibleSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( ext:politicalResponsibleContactPoint foaf:familyName );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Familienaam";
    sh:order 2;
    sh:path ( ext:politicalResponsibleContactPoint foaf:familyName ) .

ext:politicalResponsibleJobTitle
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:politicalResponsibleSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( ext:politicalResponsibleContactPoint schema:jobTitle );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Functie";
    sh:order 3;
    sh:path ( ext:politicalResponsibleContactPoint schema:jobTitle ) .

ext:samenvattendeProjectomschrijving
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        In deze samenvattende beschrijving schets je de essentie van het projectvoorstel.
    """;
    form:partOf ext:projectContentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:samenvattendeProjectomschrijving;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "1800";
        sh:path lblodSubsidie:samenvattendeProjectomschrijving;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Samenvattende projectomschrijving";
    sh:order 1;
    sh:path lblodSubsidie:samenvattendeProjectomschrijving .

ext:analyseEnProbleemstelling
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        Geef een objectieve onderbouwing (kwantitatief en/of kwalitatief) en formuleer de
        probleemstelling van de veiligheids- en/of overlastuitdaging(en) die je met dit
        project wil aanpakken. Welke kernuitdaging wil je met het projectvoorstel aanpakken?
        Denk na over achterliggende oorzaken en verbanden. Schets waar de problematiek zich
        geografisch voordoet. In deze rubriek staat centraal wat de opgave is en waarom extra
        ondersteuning nodig is.

        Formuleer tot slot de finaliteit van het projectvoorstel.
    """;
    form:partOf ext:projectContentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:analyseEnProbleemstelling;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "6000";
        sh:path lblodSubsidie:analyseEnProbleemstelling;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Analyse en probleemstelling";
    sh:order 2;
    sh:path lblodSubsidie:analyseEnProbleemstelling .

ext:projectplanFaseringEnProjectorganisatie
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        Schets de doelstelling van het project, de kritische succesfactoren, en hoe het
        project stapsgewijs zal opgezet en uitgevoerd worden. Welke concrete acties zal je
        opzetten en welke partners nemen welke taken op? Duid de projectorganisatie en
        samenwerking tussen diverse partners, en het schaalniveau waarop het georganiseerd
        wordt. Hoe zal de regie opgenomen worden en welke rollen en verantwoordelijkheden
        zullen partners opnemen? Beschrijf hoe de opvolging van het project zal
        plaatsvinden. Geef aan hoe je rond het project zal communiceren intern en/of extern.
    """;
    form:partOf ext:projectContentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:projectplanFaseringEnProjectorganisatie;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "4500";
        sh:path lblodSubsidie:projectplanFaseringEnProjectorganisatie;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Projectplan, fasering, en projectorganisatie";
    sh:order 3;
    sh:path lblodSubsidie:projectplanFaseringEnProjectorganisatie .

ext:vernieuwendKarakter
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        Schets het vernieuwend karakter van het projectvoorstel en kader dit binnen jullie
        bredere visie rond integrale veiligheid. Duid de meerwaarde van de vernieuwing en
        hoe het voorstel de werking rond veiligheid versterkt. Geef ook aan wat andere
        lokale besturen kunnen leren van de vernieuwende aanpak. Duid, indien van
        toepassing, de complementariteit met eigen bestaande initiatieven rond het thema
        veiligheid zoals jeugddelinquentie, LIVC-R of veilige huizen.
    """;
    form:partOf ext:projectContentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:vernieuwendKarakter;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "2400";
        sh:path lblodSubsidie:vernieuwendKarakter;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Vernieuwend karakter";
    sh:order 4;
    sh:path lblodSubsidie:vernieuwendKarakter .

ext:verwachteImpact
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        Duid de verwachte maatschappelijke impact van het project. Geef aan welke meetbare
        resultaten en effecten, zoals indicatoren, je beoogt bij de doelgroep of het
        aandachtsgebied. Naast de verwachte positieve effecten van acties zijn er wellicht
        ook risico's die het welslagen kunnen verhinderen of vertragen. Denk na welke
        risico's er zich zouden kunnen voordoen en hoe je deze denkt op te vangen.
    """;
    form:partOf ext:projectContentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:verwachteImpact;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "2400";
        sh:path lblodSubsidie:verwachteImpact;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Verwachte impact";
    sh:order 5;
    sh:path lblodSubsidie:verwachteImpact .

ext:subsidieBedragAanvraag
    a form:Field;
    form:displayType displayTypes:currencyInput;
    form:partOf ext:financingSection;
    form:validatedBy 
        [
            a form:PositiveNumber;
            form:grouping form:MatchEvery;
            sh:path lblodSubsidie:subsidieBedragAanvraag;
            sh:resultMessage "Het bedrag moet groter zijn dan 0."@nl
        ],
        [
            a form:MaxLength;
            form:grouping form:MatchEvery;
            form:max "120000";
            sh:path lblodSubsidie:subsidieBedragAanvraag;
            sh:resultMessage "Het maximaal toegelaten subsidiebedrag is 120.000 euro."@nl 
        ],
        [
            a form:RequiredConstraint;
            form:grouping form:Bag;
            sh:path lblodSubsidie:subsidieBedragAanvraag;
            sh:resultMessage "Dit veld is verplicht."
        ];
    sh:name "Totaal aangevraagd subsidiebedrag";
    sh:order 1;
    sh:path lblodSubsidie:subsidieBedragAanvraag .

ext:bestedingSubsidieListing
    a form:Listing, form:ListingTable;
    form:addLabel "Voeg rij toe";
    form:canAdd true;
    form:canRemove true;
    form:createGenerator ext:bestedingSubsidieGenerator;
    form:each ext:bestedingSubsidieSubForm;
    form:partOf ext:financingSection;
    form:removeLabel "Verwijder rij";
    form:scope ext:bestedingSubsidieScope;
    sh:maxCount 20;
    sh:minCount 1;
    sh:order 2 .

ext:bestedingSubsidieCompareTotals
    a form:Field;
    form:displayType displayTypes:ketenaanpakCompareTotals;
    form:partOf ext:financingSection;
    sh:order 3 .

ext:bestedingSubsidieScope
    a form:Scope;
    sh:path lblodSubsidie:subsidieBedragListingUnit .

ext:bestedingSubsidieGenerator
    a form:Generator;
    form:dataGenerator form:addMuUuid;
    form:prototype [
        form:shape [
            a lblodSubsidie:subsidieBedragListingUnit
        ]
    ] .

ext:bestedingSubsidieSubForm
    a form:SubForm;
    form:includes
        ext:bestedingSubsidieNaam,
        ext:bestedingSubsidieTypeInzet,
        ext:bestedingSubsidieActor,
        ext:bestedingSubsidieBedrag;
    form:removeLabel "Verwijder rij" .

ext:bestedingSubsidieNaam
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:financingSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:subsidieBedragListingUnitNaam;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "75";
        sh:path lblodSubsidie:subsidieBedragListingUnitNaam;
        sh:resultMessage "Max. 75 karakters overschreden."
    ];
    sh:name "Onderdeel waarvoor de subsidie zal worden ingezet";
    sh:order 1;
    sh:path lblodSubsidie:subsidieBedragListingUnitNaam .

ext:bestedingSubsidieTypeInzet
    a form:Field;
    form:displayType displayTypes:conceptSchemeSelector;
    form:options """{"conceptScheme":"http://lblod.data.gift/vocabularies/subsidie/ketenaanpak/TypeInzet","searchEnabled":false}""";
    form:partOf ext:financingSection;
    form:validatedBy [ a form:RequiredConstraint; form:grouping form:Bag; sh:path ext:subsidieTypeInzet; sh:resultMessage "Dit veld is verplicht." ];
    sh:name "Type inzet";
    sh:order 2;
    sh:path ext:subsidieTypeInzet .

ext:bestedingSubsidieActor
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:financingSection;
    form:validatedBy [ a form:RequiredConstraint; form:grouping form:Bag; sh:path ext:subsidieBesteder; sh:resultMessage "Dit veld is verplicht." ], [ a form:MaxLength; form:grouping form:MatchEvery; form:max "75"; sh:path ext:subsidieBesteder; sh:resultMessage "Max. 75 karakters overschreden." ];
    sh:name "Actor die de subsidie zal besteden";
    sh:order 3;
    sh:path ext:subsidieBesteder .

ext:bestedingSubsidieBedrag
    a form:Field;
    form:displayType displayTypes:currencyInput;
    form:partOf ext:financingSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:subsidieBedragListingUnitBedrag;
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Bedrag (€)";
    sh:order 4;
    sh:path lblodSubsidie:subsidieBedragListingUnitBedrag .

ext:cofinancieringPartnersListing
    a form:Listing, form:ListingTable;
    form:addLabel "Voeg een nieuwe partner toe";
    form:canAdd true;
    form:canRemove true;
    form:createGenerator ext:cofinancieringPartnersGenerator;
    form:each ext:cofinancieringPartnersSubForm;
    form:noDataMessage "Er werden nog geen partners toegevoegd";
    form:partOf ext:cofinancieringSection;
    form:removeLabel "Verwijder";
    form:scope ext:cofinancieringPartnersScope;
    sh:order 1 .

ext:cofinancieringPartnersScope
    a form:Scope;
    sh:path ext:financingPartner .

ext:cofinancieringPartnersGenerator
    a form:Generator;
    form:dataGenerator form:addMuUuid;
    form:prototype [
        form:shape [
            a ext:FinancingPartner;
            ext:financingAmount 0
        ]
    ] .

ext:cofinancieringPartnersSubForm
    a form:SubForm;
    form:includes
        ext:cofinancieringPartnerNaam,
        ext:cofinancieringPartnerType,
        ext:cofinancieringPartnerBedrag .

ext:cofinancieringPartnerNaam
    a form:Field;
    form:displayType displayTypes:defaultInput;
    form:partOf ext:cofinancieringSection;
    form:validations [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ext:partnerTitle;
        sh:resultMessage "Dit veld is verplicht."@nl
    ];
    sh:name "Naam partner";
    sh:order 1;
    sh:path ext:partnerTitle .

ext:cofinancieringPartnerType
    a form:Field;
    form:displayType displayTypes:conceptSchemeSelector;
    form:options """{"conceptScheme":"http://lblod.data.gift/vocabularies/subsidie/ketenaanpak/FinancieringPartnerType","searchEnabled":false}""";
    form:partOf ext:cofinancieringSection;
    form:validations [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ext:partnerType;
        sh:resultMessage "Dit veld is verplicht."@nl
    ];
    sh:name "Type partner";
    sh:order 2;
    sh:path ext:partnerType .

ext:cofinancieringPartnerBedrag
    a form:Field;
    form:displayType displayTypes:numericalInput;
    form:partOf ext:cofinancieringSection;
    form:validations [
            a form:PositiveNumber;
            form:grouping form:MatchEvery;
            sh:path ext:financingAmount;
            sh:resultMessage "Het bedrag moet groter zijn dan 0."@nl
        ],
        [
            a form:RequiredConstraint;
            form:grouping form:Bag;
            sh:path ext:financingAmount;
            sh:resultMessage "Dit veld is verplicht."@nl
        ];
    sh:name "Bedrag (€)";
    sh:order 3;
    sh:path ext:financingAmount .

ext:cofinancieringPartnersTotals
    a form:Field;
    form:displayType displayTypes:ketenaanpakFinancingTotals;
    form:partOf ext:cofinancieringSection;
    sh:name "Totaal cofinanciering";
    sh:order 2 .

ext:verduurzaming
    a form:Field;
    form:displayType displayTypes:textArea;
    form:help """
        Schets hoe het project na afloop van de subsidie ingebed en verduurzaamd zal
        worden. Welke effecten moet het project hebben op de organisatie en de samenwerking
        tussen partners na afloop van de subsidie? Welke stappen beogen jullie voor de
        structurele verankering of de continuïteit van het project? Hoe ga je verder om
        met de geleerde lessen?
    """;
    form:partOf ext:sustainabilitySection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path lblodSubsidie:verduurzaming;
        sh:resultMessage "Dit veld is verplicht."
    ], [
        a form:MaxLength;
        form:grouping form:MatchEvery;
        form:max "1800";
        sh:path lblodSubsidie:verduurzaming;
        sh:resultMessage "Max. karakters overschreden."
    ];
    sh:name "Verduurzaming";
    sh:order 1;
    sh:path lblodSubsidie:verduurzaming .

ext:bijlageDocument
    a form:Field;
    form:displayType displayTypes:files;
    form:partOf ext:attachmentSection;
    form:validatedBy [
        a form:RequiredConstraint;
        form:grouping form:Bag;
        sh:path ( lblodSubsidie:bijlageDocument dct:hasPart );
        sh:resultMessage "Dit veld is verplicht."
    ];
    sh:name "Bijlage";
    sh:order 1;
    sh:path ( lblodSubsidie:bijlageDocument dct:hasPart ) .

ext:hiddenBijlageDocument
    a form:Field;
    form:partOf ext:attachmentSection;
    sh:name "Type RemoteDataObject or FileDataObject [hidden input]";
    sh:order 2;
    sh:path ( lblodSubsidie:bijlageDocument dct:hasPart rdf:type ) .

emb:source-node
    a form:Form, form:TopLevelForm;
    form:includes
        ext:contactPersonFirstName,
        ext:contactPersonFamilyName,
        ext:contactPersonJobTitle,
        ext:contactPersonTelephone,
        ext:contactPersonEmail,
        ext:politicalResponsibleFirstName,
        ext:politicalResponsibleFamilyName,
        ext:politicalResponsibleJobTitle,
        ext:hiddenQuestionsField,   
        ext:samenvattendeProjectomschrijving,
        ext:analyseEnProbleemstelling,
        ext:projectplanFaseringEnProjectorganisatie,
        ext:vernieuwendKarakter,
        ext:verwachteImpact,
        ext:subsidieBedragAanvraag,
        ext:bestedingSubsidieListing,
        ext:bestedingSubsidieCompareTotals,
        ext:cofinancieringPartnersListing,
        ext:cofinancieringPartnersTotals,
        ext:verduurzaming,
        ext:bijlageDocument,
        ext:hiddenBijlageDocument;
    form:partOf
        ext:contactPersonSection,
        ext:politicalResponsibleSection,
        ext:questionsSection,
        ext:projectContentSection,
        ext:financingSection,
        ext:cofinancieringSection,
        ext:sustainabilitySection,
        ext:attachmentSection .
